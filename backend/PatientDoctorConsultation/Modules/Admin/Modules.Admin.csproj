<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PatientDoctorConsultation.Modules.Admin</AssemblyName>
    <RootNamespace>PatientDoctorConsultation.Modules.Admin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Shared/Shared.csproj" />
    <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="../Shared/Modules.Shared.csproj" />
    <!-- Auth: User entity for admin identity and patient account management -->
    <ProjectReference Include="../Auth/Modules.Auth.csproj" />
    <!-- Doctor: Doctor entity for moderation workflows -->
    <ProjectReference Include="../Doctor/Modules.Doctor.csproj" />
    <!-- Patient: Patient entity for moderation workflows -->
    <ProjectReference Include="../Patient/Modules.Patient.csproj" />
    <!-- Consultation: Consultation + StatusHistory for read-only monitoring -->
    <ProjectReference Include="../Consultation/Modules.Consultation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
